# AI Microservice Environment Configuration
# Copy this file to .env and fill in the actual values

# Service identity
NODE_ENV
DOMAIN
SERVICE_NAME

# Auth (same JWT_SECRET as auth-microservice for token verification)
JWT_SECRET=

# Port Configuration
AI_ORCHESTRATOR_PORT=3380
NLP_SERVICE_PORT=3381
ASR_SERVICE_PORT=3382
DOCUMENT_AI_PORT=3383
PROTOTYPE_GENERATOR_PORT=3384
TEMPLATE_REPOSITORY_PORT=3385
FREE_AI_SERVICE_PORT=3386
# URL to free-ai-service. Required for email-triage LLM when UI selects AI (LLM). Example: http://ai-microservice-free-ai-service-green:3386
FREE_AI_SERVICE_URL=
AI_WORKERS_PORT=3387
GEMINI_AI_SERVICE_PORT=3388
DATA_VIZ_SERVICE_PORT=3389

# Database (Shared - External)
# All AI agents data, workflows, submissions, and related information stored in shared database
DB_HOST=db-server-postgres
DB_PORT=5432
DB_USER=dbadmin
DB_PASSWORD=
DB_NAME=statex_ai
POSTGRES_USER=${DB_USER}
POSTGRES_PASSWORD=${DB_PASSWORD}
POSTGRES_DB=${DB_NAME}
POSTGRES_PORT=${DB_PORT}
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis (Shared - External)
REDIS_HOST=db-server-redis
REDIS_SERVER_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_SERVER_PORT}/2

# External Services (Shared Microservices)
# Logging Service - All services must send logs to centralized logging microservice
LOGGING_SERVICE_URL=https://logging.alfares.cz
LOGGING_SERVICE_API_PATH=/api/logs

# Notification Service
NOTIFICATION_SERVICE_URL=https://notifications.alfares.cz
# Telegram chat ID for contract violation escalations
TELEGRAM_CHAT_ID=

# AI orchestrator (internal URL; email-triage / shop-assistant call this)
AI_SERVICE_URL

# AI API Keys
OPENROUTER_API_BASE
OPENROUTER_MODEL
OPENROUTER_TIMEOUT
OPENROUTER_API_KEY=

# LiteLLM proxy — primary routing for /ai/complete when set (free/cheap/smart tiers)
LITELLM_MASTER_KEY=
LITELLM_BASE_URL=
LITELLM_TIMEOUT_MS=
# auto | litellm | claude_cli | claude_cli_with_litellm_fallback
AI_COMPLETE_ROUTER=

# Implementation job providers (/ai/claude-code-execute)
CC_CLI_PATH=/home/ssf/.local/bin/claude
CLAUDE_CONFIG_DIR=/home/ssf/.claude
CC_CLI_TIMEOUT_MS=120000
CODEX_CLI_PATH=/home/ssf/.local/bin/codex
CODEX_HOME=/home/ssf/.codex
CODEX_MODEL=
CODEX_SANDBOX=workspace-write
CODEX_PRINT_SANDBOX=read-only
CODEX_APPROVAL_POLICY=never

# Required: Claude API key (stored in Vault secret/prod/ai-microservice)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=

# Shop-assistant SEARCH agent (external search, e.g. Serper)
SEARCH_API_URL=
SEARCH_API_KEY=

# Email-triage classifier (agentic-email-processing-system); default 0.75
CLASSIFIER_CONFIDENCE_THRESHOLD=

# Email-triage: use LLM (free-ai-service/OpenRouter) for Classifier and Decider when true; else rule-based
EMAIL_TRIAGE_LLM_CLASSIFIER=
EMAIL_TRIAGE_LLM_DECIDER=

# S3/MinIO
S3_ENDPOINT=http://minio:9000
MINIO_INTERNAL_HOST=minio
MINIO_INTERNAL_PORT=9000

# Service Configuration
ASR_MODE=free
AI_MODE=free
DEBUG=true
LOG_LEVEL=INFO
DEPLOYMENT_URL=
TEMPLATE_GIT_REPO=
UPLOAD_DIR=./data/uploads

# Network
NGINX_NETWORK_NAME=nginx-network
DOCKER_VOLUME_BASE_PATH=/srv/storagebox/statex/docker-volumes

NODE_ENV=
DOMAIN=
SERVICE_NAME=
AI_SERVICE_URL=
OPENROUTER_API_BASE=
OPENROUTER_MODEL=
OPENROUTER_TIMEOUT=

# Langfuse LLM Observability
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-from-cloud.langfuse.com
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-from-cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Unified payments configuration
PAYMENT_APPLICATION_ID=
PAYMENT_SERVICE_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_API_KEY=
PAYMENT_CALLBACK_URL=
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=
